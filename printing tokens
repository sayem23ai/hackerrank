#include <stdio.h>

int main() {
    char sentence[1000];

    fgets(sentence, sizeof(sentence), stdin);

    for (int i = 0; sentence[i] != '\0'; i++) {
        if (sentence[i] == ' ') {
            printf("\n");
        } else if (sentence[i] != '\n') {
            printf("%c", sentence[i]);
        }
    }

    return 0;
}
