string highestValuePalindrome(string s, int n, int k) {
    vector<int> changed(n, 0);

    // Make the string a palindrome
    for (int i = 0; i < n / 2; i++) {
        if (s[i] != s[n - 1 - i]) {
            if (k == 0)
                return "-1";

            if (s[i] > s[n - 1 - i])
                s[n - 1 - i] = s[i];
            else
                s[i] = s[n - 1 - i];

            changed[i] = 1;
            k--;
        }
    }

    // Maximize the palindrome
    for (int i = 0; i < n / 2 && k > 0; i++) {
        if (s[i] != '9') {
            if (changed[i] && k >= 1) {
                s[i] = s[n - 1 - i] = '9';
                k--;
            }
            else if (!changed[i] && k >= 2) {
                s[i] = s[n - 1 - i] = '9';
                k -= 2;
            }
        }
    }

    // Middle digit (for odd length)
    if (n % 2 == 1 && k > 0)
        s[n / 2] = '9';

    return s;
}
