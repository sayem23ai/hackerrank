void minimumBribes(vector<int> q) {
    int n=q.size();
    int total=0;
    int p1=1, p2=2, p3=3;
    for(int i=0;i<n;i++){
        if(q[i]==p1){
            p1=p2;
            p2=p3;
            p3+=1;
        }
        else if(q[i]==p2){
            total+=1;
            p2=p3;
            p3+=1;
        }
        else if(q[i]==p3){
            total+=2;
            p3+=1;
        }
        else{
            cout<<"Too chaotic"<<endl;
            return;
        }
    }
    cout<<total<<endl;
    return;
}
