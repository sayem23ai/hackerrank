vector<int> jimOrders(vector<vector<int>> orders) {
 vector<pair<int, int>> v;

    for (int i = 0; i < orders.size(); i++) {
        int time = orders[i][0] + orders[i][1];
        v.push_back({time, i + 1});
    }

    sort(v.begin(), v.end());

    vector<int> ans;

    for (auto x : v) {
        ans.push_back(x.second);
    }

    return ans;
}
