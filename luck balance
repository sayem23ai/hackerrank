int luckBalance(int k, vector<vector<int>> contests) {
    int i,c=0;
    int n=contests.size();
     sort(contests.begin(), contests.end(), greater<vector<int>>());
    for(i=0;i<n;i++){
    c=c+contests[i][0];
   }
  for(i=0;i<n;i++){
    if(contests[i][1]==0){
        continue;
    }
    else if(contests[i][1]==1&&k>0){
        k--;
    }
    else{
        c-=2*contests[i][0];
    }
}
return c;
}
